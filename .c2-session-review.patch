+    fn signal_only_instance() -> (SceneInstance, SignalId) {
+        let mut store = SemanticStore::new();
+        let object = store.insert_semantic_object(SemanticObjectState::new(
+            StoredGeometry::Circle { radius: 1.0 },
+        ));
+        store.attach_to_scene(object).unwrap();
+        let mut index = SemanticExecutionIndex::new();
+        let lowered = lower_semantic_execution(&store, &mut index).unwrap();
+        let mut instance = SceneInstance::from_semantic_execution(lowered);
+        let signal = SignalId::new(0);
+        let enrollment = instance.prepare_reactive_signal_enrollment(
+            Some(signal), ReactiveValue::Scalar(1.0),
+        ).unwrap();
+        instance.commit_reactive_signal_enrollment(enrollment, signal);
+        instance.take_frame_changes();
+        (instance, signal)
+    }
+
+    #[test]
+    fn prepared_signal_only_change_publishes_once_without_dirty_rows() {
+        let (mut instance, signal) = signal_only_instance();
+        let before = instance.publication_context();
+        let frame = instance.frame().clone();
+        let prepared = instance.prepare_advance_to_with_reactive_inputs(
+            0.0, &[(signal, ReactiveValue::Scalar(2.0))],
+        ).unwrap();
+        assert_eq!(instance.publication_context(), before);
+        assert_eq!(instance.reactive_value(signal), Some(&ReactiveValue::Scalar(1.0)));
+        let effective = instance.prepare_effective_property_batch(&[]).unwrap();
+        instance.commit_prepared_frame(prepared, effective).unwrap();
+        let after = before.with_frame_epoch(before.frame_epoch().checked_next().unwrap());
+        assert_eq!(instance.publication_context(), after);
+        assert_eq!(instance.reactive_value(signal), Some(&ReactiveValue::Scalar(2.0)));
+        assert_eq!(instance.frame(), &frame);
+        assert!(instance.take_frame_changes().is_empty());
+        instance.advance_to_with_reactive_inputs(0.0, &[(signal, ReactiveValue::Scalar(2.0))]).unwrap();
+        assert_eq!(instance.publication_context(), after);
+        assert!(instance.take_frame_changes().is_empty());
+    }
+
+    #[test]
+    fn signal_only_commit_invalidates_older_prepared_reads() {
+        let (mut instance, signal) = signal_only_instance();
+        let old = instance.prepare_advance_to(0.0).unwrap();
+        let effective = instance.prepare_effective_property_batch(&[]).unwrap();
+        instance.advance_to_with_reactive_inputs(0.0, &[(signal, ReactiveValue::Scalar(2.0))]).unwrap();
+        let current = instance.publication_context();
+        assert!(matches!(instance.commit_prepared_frame(old, effective),
+            Err(PreparedFrameCommitError::StalePublication { .. })));
+        assert_eq!(instance.publication_context(), current);
+        assert_eq!(instance.reactive_value(signal), Some(&ReactiveValue::Scalar(2.0)));
+        assert!(instance.take_frame_changes().is_empty());
+    }
+
+    #[test]
+    fn signal_only_epoch_exhaustion_is_a_typed_atomic_input_error() {
+        let (mut instance, signal) = signal_only_instance();
+        let max_epoch = noon_core::FrameEpoch::new(u64::MAX);
+        instance.publication = instance.publication_context().with_frame_epoch(max_epoch);
+        let before = instance.publication_context();
+        let frame = instance.frame().clone();
+        assert_eq!(instance.advance_to_with_reactive_inputs(0.0, &[(signal, ReactiveValue::Scalar(2.0))]),
+            Err(EvaluationError::FrameEpochExhausted(max_epoch)));
+        assert_eq!(instance.publication_context(), before);
+        assert_eq!(instance.reactive_value(signal), Some(&ReactiveValue::Scalar(1.0)));
+        assert_eq!(instance.frame(), &frame);
+        assert!(instance.take_frame_changes().is_empty());
+        instance.advance_to_with_reactive_inputs(0.0, &[(signal, ReactiveValue::Scalar(1.0))]).unwrap();
+        assert_eq!(instance.publication_context(), before);
+    }
