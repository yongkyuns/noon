from pathlib import Path
import re

# 1. Promote stroke-width mode into the legacy/wire style so renderers can consume it.
p = Path('crates/noon-core/src/lib.rs')
s = p.read_text()
needle = '''#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum StrokeCap {
    #[default]
    Round,
    Butt,
    Square,
}

'''
insert = needle + '''#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum StrokeWidthMode {
    /// Geometry/object scaling also scales stroke width.
    #[default]
    ScaleWithObject,
    /// Stroke width is authored in physical canvas pixels and does not scale with the object.
    ScreenSpace,
}

'''
assert needle in s
s = s.replace(needle, insert, 1)
s = s.replace(
    '''    pub stroke_width: f32,
    #[serde(default)]
    pub stroke_join: StrokeJoin,''',
    '''    pub stroke_width: f32,
    #[serde(default)]
    pub stroke_width_mode: StrokeWidthMode,
    #[serde(default)]
    pub stroke_join: StrokeJoin,''',
    1,
)
s = s.replace(
    '''            stroke_width: 1.0,
            stroke_join: StrokeJoin::Round,''',
    '''            stroke_width: 1.0,
            stroke_width_mode: StrokeWidthMode::ScaleWithObject,
            stroke_join: StrokeJoin::Round,''',
    1,
)
p.write_text(s)

p = Path('crates/noon-core/src/semantic_model.rs')
s = p.read_text()
s = s.replace(
    'use crate::{Color, PathCommand, Style, Vec2, VectorPath};',
    'use crate::{Color, PathCommand, StrokeWidthMode, Style, Vec2, VectorPath};',
)
block = '''#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum StrokeWidthMode {
    /// Compatibility mode: geometry/object scaling also scales stroke width.
    #[default]
    ScaleWithObject,
    /// Stroke remains screen-space sized while geometry scales.
    ScreenSpace,
}

'''
assert block in s
s = s.replace(block, '', 1)
s = s.replace(
    '''            stroke_width_mode: StrokeWidthMode::ScaleWithObject,
            object_opacity: style.opacity as f64,''',
    '''            stroke_width_mode: style.stroke_width_mode,
            object_opacity: style.opacity as f64,''',
    1,
)
p.write_text(s)

# 2. Preserve width mode through style interpolation.
p = Path('crates/noon-runtime/src/lib.rs')
s = p.read_text()
needle = '''        stroke_width: lerp(from.stroke_width, to.stroke_width, progress),
        stroke_join: if progress >= 1.0 {'''
repl = '''        stroke_width: lerp(from.stroke_width, to.stroke_width, progress),
        stroke_width_mode: if progress >= 1.0 {
            to.stroke_width_mode
        } else {
            from.stroke_width_mode
        },
        stroke_join: if progress >= 1.0 {'''
assert needle in s
p.write_text(s.replace(needle, repl, 1))

# Existing complete Style literals are legacy/world-space unless they use struct update syntax.
for p in Path('crates').rglob('*.rs'):
    lines = p.read_text().splitlines(True)
    out = []
    i = 0
    changed = False
    while i < len(lines):
        line = lines[i]
        if re.search(r'\bStyle\s*\{', line) and 'pub struct Style' not in line and 'impl Default for Style' not in line:
            start = i
            balance = line.count('{') - line.count('}')
            j = i + 1
            while j < len(lines) and balance > 0:
                balance += lines[j].count('{') - lines[j].count('}')
                j += 1
            block_lines = lines[start:j]
            text = ''.join(block_lines)
            if 'stroke_width:' in text and 'stroke_width_mode:' not in text and '..Style::default()' not in text and '..style_' not in text:
                new = []
                inserted = False
                for bl in block_lines:
                    new.append(bl)
                    if not inserted and re.match(r'^(\s*)stroke_width\s*:', bl):
                        indent = re.match(r'^(\s*)', bl).group(1)
                        if p.as_posix().startswith('crates/noon-core/') and '/tests/' not in p.as_posix():
                            value = 'StrokeWidthMode::ScaleWithObject'
                        else:
                            value = 'noon_core::StrokeWidthMode::ScaleWithObject'
                        new.append(f'{indent}stroke_width_mode: {value},\n')
                        inserted = True
                if inserted:
                    block_lines = new
                    changed = True
            out.extend(block_lines)
            i = j
        else:
            out.append(line)
            i += 1
    if changed:
        p.write_text(''.join(out))

# 3. Carry mode over the Python legacy IR and live patch channel.
p = Path('web/python/_noon_ir.py')
s = p.read_text()
needle = '''def _stroke_cap(value: Any) -> str:
    if not isinstance(value, str):
        raise TypeError("stroke_cap must be a string")
    if value not in {"round", "butt", "square"}:
        