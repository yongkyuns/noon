diff --git a/parity/manim-v0.21/core-examples/group_slicing.py b/parity/manim-v0.21/core-examples/group_slicing.py
new file mode 100644
--- /dev/null
+++ b/parity/manim-v0.21/core-examples/group_slicing.py
@@ -0,0 +1,13 @@
+from manim import *
+
+
+class GroupSlicing(Scene):
+    def construct(self):
+        first = Square(side_length=0.5).shift(LEFT * 2.0)
+        middle = Circle(radius=0.3)
+        last = Rectangle(width=0.8, height=0.4).shift(RIGHT * 2.0)
+        family = VGroup(first, middle, last)
+
+        self.add(*family)
+        family[1:].shift(UP * 0.75)
+        self.wait(1.0)

