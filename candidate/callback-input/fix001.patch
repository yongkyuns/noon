+#[test]
+fn later_callback_failure_discards_earlier_overlay_writes_without_replaying_callables() {
+    let mut f = fixture(0.0, 0);
+    let mut table = RustHostCallbackTable::new();
+    let calls = Rc::new(RefCell::new(Vec::new()));
+    let first = calls.clone();
+    table.insert(FIRST, move |cx| {
+        first.borrow_mut().push(FIRST);
+        let mut style = cx.target_state().style;
+        style.opacity = 0.25;
+        cx.set_target_style(style)
+    }).unwrap();
+    let second = calls.clone();
+    table.insert(SECOND, move |cx| {
+        second.borrow_mut().push(SECOND);
+        assert_eq!(cx.target_state().style.opacity, 0.25);
+        Err::<(), _>(std::io::Error::other("failure after an earlier overlay write"))
+    }).unwrap();
+    let before = f.session.frame().clone();
+    let publication = f.session.publication_context();
+    let input = press(&f.session, 0);
+    assert!(table.submit_input(&mut f.session, input.clone()).is_err());
+    assert_eq!(*calls.borrow(), [FIRST, SECOND]);
+    assert_eq!(f.session.frame(), &before);
+    assert_eq!(f.session.publication_context(), publication);
+    assert_eq!(f.session.last_native_event_sequence, None);
+    assert_eq!(f.session.selected_pointer_target(), None);
+    assert_eq!(f.session.effective_signal_value(f.down), Some(&ReactiveValue::Scalar(0.0)));
+    assert_eq!(f.session.effective_signal_value(f.held), Some(&ReactiveValue::Bool(false)));
+    assert!(table.submit_input(&mut f.session, input).is_err());
+    assert_eq!(*calls.borrow(), [FIRST, SECOND], "failed callables cannot replay");
+    // Arbitrary host side effects (the call log) did happen. Only engine-owned
+    // native/callback/selection publication is atomic, not external host I/O.
+}
