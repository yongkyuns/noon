index f76ba8fc7472d9befecdc9a48b130c9b9305dc1e..a5d70b534233a9234fa99b71ef0958d0a5d0ddbd 100644
--- a/crates/noon-web/src/semantic_execution_player/pointer_input/presentation_tests.rs
+++ b/crates/noon-web/src/semantic_execution_player/pointer_input/presentation_tests.rs
@@ -252,3 +252,20 @@ fn retained_pointer_view_validation_rejects_invalid_mapping_before_mirror_admiss
     d.pointer_view=Some(PointerPresentationView{revision:1,width:800.0,height:400.0});
     assert!(d.validate().is_ok());
