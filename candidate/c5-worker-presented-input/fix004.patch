diff --git a/web/execution-worker-client.test.mjs b/web/execution-worker-client.test.mjs
index e1b5bb249faef490dc5a0d5cc3e438a09418be37..8eb0943d587f910f21ccc84f414fddbb477d8b55 100644
--- a/web/execution-worker-client.test.mjs
