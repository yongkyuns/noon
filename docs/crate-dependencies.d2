# Complete internal Cargo dependency map for the active workspace. docs/architecture.md remains normative.
# D2 has no built-in Google Material theme; this source uses a Material-inspired palette.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}
style.fill: "#F8FAFD"
classes: {
  crate: {width: 300; height: 96; style: {font-size: 19; bold: true; font-color: "#202124"; fill: "#FFFFFF"; stroke: "#DADCE0"; border-radius: 12; stroke-width: 1; shadow: true}}
  core: {width: 300; height: 96; style: {font-size: 19; bold: true; font-color: "#202124"; fill: "#E8F0FE"; stroke: "#1967D2"; border-radius: 12; stroke-width: 2; shadow: true}}
  provider: {width: 300; height: 96; style: {font-size: 19; bold: true; font-color: "#202124"; fill: "#E6F4EA"; stroke: "#137333"; border-radius: 12; stroke-width: 1; shadow: true}}
  host: {width: 300; height: 96; style: {font-size: 19; bold: true; font-color: "#202124"; fill: "#FEF7E0"; stroke: "#B06000"; border-radius: 12; stroke-width: 1; shadow: true}}
  edge: {style: {stroke: "#5F6368"; stroke-width: 2}}
  optional: {style: {stroke: "#7E57C2"; stroke-width: 2; stroke-dash: 5}}
}

direction: down
horizontal-gap: 104
vertical-gap: 66

native: "noon-native\nnative host / winit surface" {class: host}
web: "noon-web\nWASM/browser host + transport" {class: host}
noon: "noon\npublic Rust API + session orchestration" {class: crate}
renderer: "noon-render-wgpu\nretained wgpu renderer" {class: crate}
runtime: "noon-runtime\ndeterministic effective runtime" {class: core}
compile: "noon-compile\nsemantic → execution lowering" {class: core}
geometry: "noon-geometry\npath algorithms + tessellation" {class: provider}
text: "noon-text\nshaping + glyph raster services" {class: provider}
typst: "noon-typst\nTypst text/math layout provider" {class: provider}
core: "noon-core\nsemantic identities/store/resources\nrenderer-independent contracts" {class: core}

# Arrow direction means “depends on”. Repeated labels were removed to keep routing clean.
native -> noon {class: edge}
native -> renderer {class: edge}
native -> core {class: edge}
web -> noon {class: edge}
web -> compile {class: edge}
web -> runtime {class: edge}
web -> geometry {class: edge}
web -> core {class: edge}
web -> renderer: "renderer feature / wasm32" {class: optional}
noon -> compile {class: edge}
noon -> runtime {class: edge}
noon -> geometry {class: edge}
noon -> core {class: edge}
noon -> text: "native-text feature" {class: optional}
noon -> typst: "typst feature" {class: optional}
renderer -> runtime {class: edge}
renderer -> geometry {class: edge}
renderer -> text {class: edge}
renderer -> core {class: edge}
runtime -> compile {class: edge}
runtime -> core {class: edge}
compile -> geometry {class: edge}
compile -> core {class: edge}
geometry -> core {class: edge}
text -> core {class: edge}
typst -> core {class: edge}

legend: "Arrow direction = Cargo dependency\nSolid gray = normal internal dependency\nDashed purple = feature/target-conditional dependency\nDev-dependencies are omitted here and listed in the reader guide." {
  shape: text
  near: bottom-right
  style: {font-size: 17; italic: true; font-color: "#5F6368"}
}
