# Direct Rust/WASM path, not the optional Python worker topology.
...@_style

direction: down
app: "Compiled Rust/WASM application\nsame noon API and scene semantics" {class: node}
engine: "ONE WASM CONTEXT · typed in-process boundaries" {
  direction: down
  scene: "Semantic Scene\nshared Rust operations + SemanticStore" {class: authority}
  plan: "Execution Plan\nnoon-compile · derived CompiledScene" {class: authority}
  runtime: "Runtime\nnoon-runtime · effective state and scheduling" {class: authority}
  renderer: "Retained renderer\nnoon-render-wgpu · same rendering implementation" {class: authority}
  scene -> plan: "typed lowering"
  plan -> runtime: "typed execution data"
  runtime -> renderer: "typed frame / publication"
}
host: "noon-web + JavaScript platform glue\nWASM bootstrap · canvas · input · frame scheduling\nWebGPU / WebGL2 surface" {class: host}
app -> engine.scene: "author and mutate"
engine.renderer -> host: "encode for host-owned canvas"
note: "A browser target is not a transport boundary.\nJavaScript does not relay state between Rust layers." {class: note}
host -> note: {style.opacity: 0}
