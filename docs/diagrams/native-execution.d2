# Direct native path. Hosts drive execution and presentation; they own no semantic state.
...@_style

direction: down
app: "Compiled Rust application\nordinary noon API" {class: node}
engine: "ONE NATIVE PROCESS · typed in-memory boundaries" {
  direction: down
  scene: "Semantic Scene\nshared Rust operations + SemanticStore" {class: authority}
  plan: "Execution Plan\nnoon-compile · derived CompiledScene" {class: authority}
  runtime: "Runtime\nnoon-runtime · effective state and scheduling" {class: authority}
  renderer: "Retained renderer\nnoon-render-wgpu · dirty resources and draw work" {class: authority}
  scene -> plan: "typed lowering"
  plan -> runtime: "typed execution data"
  runtime -> renderer: "typed frame / publication"
}
host: "noon-native\nwinit window · events · wgpu surface\nacquire / submit / present / recover" {class: host}
app -> engine.scene: "author and mutate"
engine.renderer -> host: "encode for host-owned surface"
note: "No Python, JavaScript, WASM, JSON or transport document\nis required between these engine layers." {class: note}
host -> note: {style.opacity: 0}
