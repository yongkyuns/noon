# Component composition; arrows are data flow, not Cargo dependencies.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}
direction: right
style.fill: "#FFFFFF"
classes: {
  component: {style: {font-size: 20; bold: false; font-color: "#263445"; fill: "#FFFFFF"; stroke: "#AEBBCB"; border-radius: 5; stroke-width: 1}}
  group: {style: {font-size: 22; bold: true; font-color: "#263445"; fill: "#F1F5F9"; stroke: "#AEBBCB"; border-radius: 7; stroke-width: 1}}
}
grid-columns: 3
horizontal-gap: 154
model: "SemanticStore\nnoon-core" {
  class: group
  grid-columns: 1
  grid-gap: 18
  objects: "Objects & families\nidentity · membership" {class: component; width: 246; height: 60}
  state: "Transforms & paint\nauthored values" {class: component; width: 246; height: 60}
  animation: "Animation trees\ncomposition · targets" {class: component; width: 246; height: 60}
  signals: "Signals & updaters\nbindings · callbacks" {class: component; width: 246; height: 60}
  resources: "Content resources\ngeometry · text · fonts" {class: component; width: 246; height: 60}
}
session: "ExecutionSession\nnoon" {
  class: group
  grid-columns: 1
  grid-gap: 18
  mapping: "Identity / slot map" {class: component; width: 290; height: 50}
  runtime: "SceneInstance · noon-runtime" {
    class: group
    style.fill: "#E7EDF4"
    grid-columns: 1
    grid-gap: 12
    plan: "CompiledScene\nslots · tracks · resources" {class: component; width: 262; height: 70}
    drivers: "Timeline + reactive" {class: component; width: 262; height: 50}
    frame: "FrameState\neffective values" {class: component; width: 262; height: 70}
  }
  spatial: "Spatial index" {class: component; width: 290; height: 50}
  gates: "Segment / callback gates" {class: component; width: 290; height: 50}
}
renderer: "Rendering\nnoon-render-wgpu" {
  class: group
  grid-columns: 1
  grid-gap: 18
  instances: "Instance buffers\ntransform · paint" {class: component; width: 234; height: 70}
  meshes: "Mesh cache\nprepared geometry" {class: component; width: 234; height: 70}
  atlas: "Glyph atlas\ntext rendering" {class: component; width: 234; height: 70}
  batches: "Draw batches\npainter order" {class: component; width: 234; height: 70}
}
model -> session: "noon-compile\nlower / prepare" {style: {font-size: 18; stroke-width: 2; stroke: "#6B7F94"; font-color: "#4C5D70"}}
session -> renderer: "publish\nframe + changes" {style: {font-size: 18; stroke-width: 2; stroke: "#6B7F94"; font-color: "#4C5D70"}}
