# Shared presentation only. Architectural meaning remains in docs/architecture.md.
classes: {
  node: {
    style: {
      border-radius: 8
      font-size: 19
      stroke-width: 2
    }
  }
  authority: {
    style: {
      border-radius: 8
      font-size: 19
      bold: true
      stroke-width: 3
    }
  }
  host: {
    style: {border-radius: 8; font-size: 19; stroke-width: 2; stroke-dash: 4}
  }
  future: {
    style: {border-radius: 8; font-size: 19; stroke-width: 2; stroke-dash: 4; italic: true}
  }
  note: {
    shape: text
    style: {
      font-size: 17
      italic: true
    }
  }
}
