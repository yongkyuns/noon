    {
      "id": "unsupported-three-d",
      "kind": "capability",
      "covers": ["unsupported-3d"],
      "example": "three-d",
      "expectedStatus": "deferred",
      "requiredFeatures": ["ThreeDScene", "ThreeDAxes", "Surface"]
    },
    {
      "id": "cancel-stuck-after-first-frame",
      "kind": "cancellation",
      "covers": ["cancellation"],
      "sourcePath": "eval/scenes/stuck_after_first_frame.py",
