    {
      "id": "unsupported-latex-mathtex",
      "kind": "capability",
      "covers": ["unsupported-latex"],
      "example": "text-and-math",
      "expectedStatus": "blocked",
      "requiredFeatures": ["Tex", "MathTex"]
